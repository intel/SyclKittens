# Source this file before building SyclKittens.

SYCLKITTENS_ROOT=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
export SYCLKITTENS_ROOT
export KITTENS_TARGET=INTEL
export PYTHONPATH="${SYCLKITTENS_ROOT}/include/pyutils${PYTHONPATH:+:${PYTHONPATH}}"

_sk_source_optional() {
    local saved_flags=$-
    set +e
    set +u
    source "$@" >/dev/null 2>&1
    case "$saved_flags" in *u*) set -u ;; esac
    case "$saved_flags" in *e*) set -e ;; esac
    return 0
}

if [ -f /opt/intel/oneapi/setvars.sh ]; then
    _sk_source_optional /opt/intel/oneapi/setvars.sh --force
fi

if ! command -v icpx >/dev/null 2>&1; then
    echo "WARNING: icpx is not available; source an Intel oneAPI environment."
fi

unset -f _sk_source_optional
