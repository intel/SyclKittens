// Standalone harness for gqa_backward.dp.cpp (CONFIG=standalone, no PyTorch).
// Included at the end of gqa_backward.dp.cpp when TORCH_COMPILE is not defined,
// so ATTN_H/ATTN_H_KV/ATTN_D, BLOCK_N and run_prep()/run_bwd() are in scope.
//
//   usage: gqa_backward [iters=100] [warmup=10]
//   pick the GPU with ONEAPI_DEVICE_SELECTOR / ZE_AFFINITY_MASK.
//
// The kernel is causal-only. Runs B=1, N=256 (multiple of BLOCK_N) so a full
// fp32 CPU reference for delta, dQ, dK, dV is cheap; reports rel-L2 for each.

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <vector>

// Deterministic values in [-1, 1) so the run is reproducible.
static float lcg_uniform(uint32_t &state) {
    state = state * 1664525u + 1013904223u;
    return static_cast<float>(state >> 8) / static_cast<float>(1u << 23) - 1.0f;
}

static double rel_l2(const std::vector<float> &got, const std::vector<double> &ref) {
    double e = 0.0, r = 0.0;
    for (size_t i = 0; i < ref.size(); i++) {
        e += (got[i] - ref[i]) * (got[i] - ref[i]);
        r += ref[i] * ref[i];
    }
    return std::sqrt(e / (r + 1e-30));
}

int main(int argc, char **argv) {
    const int iters  = argc > 1 ? std::atoi(argv[1]) : 100;
    const int warmup = argc > 2 ? std::atoi(argv[2]) : 10;
    constexpr int B = 1, N = 256, H = ATTN_H, HKV = ATTN_H_KV, D = ATTN_D;
    constexpr int GROUP = H / HKV;
    static_assert(N % BLOCK_N == 0, "N must be a multiple of BLOCK_N");

    sycl::queue queue{sycl::gpu_selector_v, sycl::property::queue::in_order{}};
    std::printf("Device: %s\n",
                queue.get_device().get_info<sycl::info::device::name>().c_str());

    const size_t size_q = size_t(N) * H * D, size_kv = size_t(N) * HKV * D;
    std::vector<bf16> h_q(size_q), h_k(size_kv), h_v(size_kv), h_do(size_q), h_o(size_q);
    uint32_t seed = 12345u;
    for (auto &x : h_q)  x = bf16(lcg_uniform(seed));
    for (auto &x : h_k)  x = bf16(lcg_uniform(seed));
    for (auto &x : h_v)  x = bf16(lcg_uniform(seed));
    for (auto &x : h_do) x = bf16(lcg_uniform(seed));

    auto q_at  = [&](int n, int h, int d) { return double(float(h_q[(size_t(n) * H + h) * D + d])); };
    auto k_at  = [&](int n, int h, int d) { return double(float(h_k[(size_t(n) * HKV + h) * D + d])); };
    auto v_at  = [&](int n, int h, int d) { return double(float(h_v[(size_t(n) * HKV + h) * D + d])); };
    auto do_at = [&](int n, int h, int d) { return double(float(h_do[(size_t(n) * H + h) * D + d])); };

    // ---- CPU forward: P (causal softmax of S/sqrt(D)), O (bf16, fed to the kernel), L.
    const double scale = 1.0 / std::sqrt(double(D));
    std::vector<double> P(size_t(H) * N * N, 0.0);
    std::vector<float> h_l(size_t(H) * N);
    for (int h = 0; h < H; h++) {
        const int kvh = h / GROUP;
        for (int i = 0; i < N; i++) {
            double *p = &P[(size_t(h) * N + i) * N];
            double m = -1e300;
            for (int j = 0; j <= i; j++) {
                double dot = 0.0;
                for (int d = 0; d < D; d++) dot += q_at(i, h, d) * k_at(j, kvh, d);
                p[j] = dot * scale;
                m = std::max(m, p[j]);
            }
            double sum = 0.0;
            for (int j = 0; j <= i; j++) { p[j] = std::exp(p[j] - m); sum += p[j]; }
            for (int j = 0; j <= i; j++) p[j] /= sum;
            h_l[size_t(h) * N + i] = float(m + std::log(sum));
            for (int d = 0; d < D; d++) {
                double o = 0.0;
                for (int j = 0; j <= i; j++) o += p[j] * v_at(j, kvh, d);
                h_o[(size_t(i) * H + h) * D + d] = bf16(float(o));
            }
        }
    }
    auto o_at = [&](int n, int h, int d) { return double(float(h_o[(size_t(n) * H + h) * D + d])); };

    // ---- CPU backward reference.
    std::vector<double> delta_ref(size_t(H) * N), dq_ref(size_q, 0.0), dk_ref(size_kv, 0.0), dv_ref(size_kv, 0.0);
    std::vector<double> dS(N);
    for (int h = 0; h < H; h++) {
        const int kvh = h / GROUP;
        for (int i = 0; i < N; i++) {
            double dl = 0.0;
            for (int d = 0; d < D; d++) dl += do_at(i, h, d) * o_at(i, h, d);
            delta_ref[size_t(h) * N + i] = dl;
            const double *p = &P[(size_t(h) * N + i) * N];
            for (int j = 0; j <= i; j++) {
                double dp = 0.0;
                for (int d = 0; d < D; d++) dp += do_at(i, h, d) * v_at(j, kvh, d);
                dS[j] = p[j] * (dp - dl);
            }
            for (int j = 0; j <= i; j++)
                for (int d = 0; d < D; d++) {
                    dq_ref[(size_t(i) * H + h) * D + d]   += dS[j] * k_at(j, kvh, d) * scale;
                    dk_ref[(size_t(j) * HKV + kvh) * D + d] += dS[j] * q_at(i, h, d) * scale;
                    dv_ref[(size_t(j) * HKV + kvh) * D + d] += p[j] * do_at(i, h, d);
                }
        }
    }

    // ---- GPU.
    bf16  *d_q  = sycl::malloc_device<bf16>(size_q, queue);
    bf16  *d_k  = sycl::malloc_device<bf16>(size_kv, queue);
    bf16  *d_v  = sycl::malloc_device<bf16>(size_kv, queue);
    bf16  *d_do = sycl::malloc_device<bf16>(size_q, queue);
    bf16  *d_o  = sycl::malloc_device<bf16>(size_q, queue);
    float *d_l  = sycl::malloc_device<float>(size_t(H) * N, queue);
    float *d_delta = sycl::malloc_device<float>(size_t(H) * N, queue);
    float *d_dq = sycl::malloc_device<float>(size_q, queue);
    float *d_dk = sycl::malloc_device<float>(size_kv, queue);
    float *d_dv = sycl::malloc_device<float>(size_kv, queue);
    bf16  *d_pt  = sycl::malloc_device<bf16>(size_kv, queue);   // reorder scratch, B*N*HKV*D each
    bf16  *d_dst = sycl::malloc_device<bf16>(size_kv, queue);
    bf16  *d_dsq = sycl::malloc_device<bf16>(size_kv, queue);
    queue.memcpy(d_q, h_q.data(), size_q * sizeof(bf16));
    queue.memcpy(d_k, h_k.data(), size_kv * sizeof(bf16));
    queue.memcpy(d_v, h_v.data(), size_kv * sizeof(bf16));
    queue.memcpy(d_do, h_do.data(), size_q * sizeof(bf16));
    queue.memcpy(d_o, h_o.data(), size_q * sizeof(bf16));
    queue.memcpy(d_l, h_l.data(), h_l.size() * sizeof(float));
    queue.wait();

    auto step = [&] {
        run_prep(queue, d_o, d_do, d_delta, B, N, H);
        run_bwd(queue, d_q, d_k, d_v, d_do, d_l, d_delta, d_dq, d_dk, d_dv,
                d_pt, d_dst, d_dsq, B, N, H, HKV);
    };
    for (int i = 0; i < warmup; i++) step();
    queue.wait();
    const auto t0 = std::chrono::high_resolution_clock::now();
    for (int i = 0; i < iters; i++) step();
    queue.wait();
    const auto t1 = std::chrono::high_resolution_clock::now();
    const double ms = std::chrono::duration<double, std::milli>(t1 - t0).count() / iters;
    // Backward ~ 2.5x the causal forward FLOPs (same convention as ThunderKittens).
    const double flops = 2.5 * 4.0 * B * H * double(N) * N * D * 0.5;

    std::vector<float> g_delta(size_t(H) * N), g_dq(size_q), g_dk(size_kv), g_dv(size_kv);
    queue.memcpy(g_delta.data(), d_delta, g_delta.size() * sizeof(float));
    queue.memcpy(g_dq.data(), d_dq, size_q * sizeof(float));
    queue.memcpy(g_dk.data(), d_dk, size_kv * sizeof(float));
    queue.memcpy(g_dv.data(), d_dv, size_kv * sizeof(float));
    queue.wait();

    const double e_delta = rel_l2(g_delta, delta_ref), e_dq = rel_l2(g_dq, dq_ref);
    const double e_dk = rel_l2(g_dk, dk_ref), e_dv = rel_l2(g_dv, dv_ref);
    const bool pass = e_delta < 1e-2 && e_dq < 3e-2 && e_dk < 3e-2 && e_dv < 3e-2;
    std::printf("GQA bwd B%d N%d H%d/%d D%d causal (prep+bwd): %.3f ms  %.1f TFLOP/s  "
                "(iters=%d warmup=%d)  rel_l2 delta=%.2e dQ=%.2e dK=%.2e dV=%.2e  %s\n",
                B, N, H, HKV, D, ms, flops / (ms * 1e-3) / 1e12, iters, warmup,
                e_delta, e_dq, e_dk, e_dv, pass ? "PASS" : "FAIL");

    for (void *p : {(void *)d_q, (void *)d_k, (void *)d_v, (void *)d_do, (void *)d_o, (void *)d_l,
                    (void *)d_delta, (void *)d_dq, (void *)d_dk, (void *)d_dv,
                    (void *)d_pt, (void *)d_dst, (void *)d_dsq})
        sycl::free(p, queue);
    return pass ? 0 : 1;
}
